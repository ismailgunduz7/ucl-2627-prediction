# ---- Server ----
# PostgreSQL connection string (Supabase or local)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ucl_fantasy

# Secret used to sign short-lived access JWTs (use a long random string)
JWT_SECRET=change-me-to-a-long-random-secret

# Access token lifetime (seconds). Refresh token lifetime below.
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600

# Obscure base path that gates the admin UI/API (defence in depth, not the only guard)
ADMIN_PATH=/yonetim

# Allowed browser origin for CORS + refresh cookie
CLIENT_ORIGIN=http://localhost:5173

# football-data.org API v4 token (used from Phase 3 onward; server-side only)
FOOTBALL_DATA_API_TOKEN=

# Poll the score provider in the background. Off locally so the mock clock stays
# under the admin's control; turn it on in deploy. Cadence adapts on its own:
# about a minute while matches are in play, half an hour in the run-up, and
# twice a day on a day with nothing to play.
SYNC_SCHEDULER_ENABLED=false

# Shared secret for POST/GET /api/cron/tick, the heartbeat an external cron
# service pings on a host that sleeps between requests. Leave empty and the
# endpoint refuses every caller. Generate with: openssl rand -hex 32
CRON_SECRET=

# HTTP port the API listens on
PORT=8787

# Set to "production" in deploy; controls Secure cookie flag + error verbosity
NODE_ENV=development

# ---- Client (Vite, must be prefixed VITE_) ----
VITE_API_BASE_URL=http://localhost:8787
